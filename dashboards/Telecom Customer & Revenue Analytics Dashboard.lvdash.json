{
  "datasets": [
    {
      "name": "executive_kpis",
      "displayName": "Executive KPIs",
      "queryLines": [
        "SELECT\n",
        "  total_customers,\n",
        "  active_subscriptions,\n",
        "  total_billed_revenue,\n",
        "  total_collected_revenue,\n",
        "  total_outstanding_amount,\n",
        "  total_complaints,\n",
        "  high_risk_customers\n",
        "FROM\n",
        "  telecom.gold.vw_executive_kpis"
      ],
      "columns": [
        {
          "displayName": "churn_rate_pct",
          "description": "Percentage of customers at high churn risk",
          "expression": "ROUND((high_risk_customers * 100.0 / total_customers), 2)"
        },
        {
          "displayName": "arpu",
          "description": "Average Revenue Per User",
          "expression": "ROUND(total_billed_revenue / active_subscriptions, 2)"
        },
        {
          "displayName": "payment_success_pct",
          "description": "Payment collection success rate",
          "expression": "ROUND((total_collected_revenue * 100.0 / total_billed_revenue), 2)"
        },
        {
          "displayName": "retention_rate_pct",
          "description": "Customer retention rate",
          "expression": "ROUND(100.0 - (high_risk_customers * 100.0 / total_customers), 2)"
        }
      ],
      "catalog": "telecom",
      "schema": "gold"
    },
    {
      "name": "high_risk_customers",
      "displayName": "High-Risk Customers",
      "queryLines": [
        "SELECT\n",
        "  customer_id,\n",
        "  customer_name,\n",
        "  current_plan,\n",
        "  customer_status,\n",
        "  outstanding_amount,\n",
        "  total_complaints,\n",
        "  failed_payments,\n",
        "  payment_success_rate,\n",
        "  churn_risk_score,\n",
        "  churn_risk_level\n",
        "FROM\n",
        "  telecom.gold.customer_360\n",
        "WHERE\n",
        "  churn_risk_level = 'HIGH'\n",
        "ORDER BY\n",
        "  churn_risk_score DESC,\n",
        "  outstanding_amount DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "plan_performance",
      "displayName": "Plan Performance",
      "queryLines": [
        "SELECT\n",
        "  plan_name,\n",
        "  total_revenue,\n",
        "  active_subscriptions,\n",
        "  cancelled_subscriptions,\n",
        "  total_data_gb\n",
        "FROM\n",
        "  telecom.gold.vw_plan_performance\n",
        "ORDER BY\n",
        "  total_revenue DESC"
      ]
    },
    {
      "name": "usage_analysis",
      "displayName": "Usage Analysis",
      "queryLines": [
        "SELECT\n",
        "  year_month,\n",
        "  total_call_minutes,\n",
        "  total_sms,\n",
        "  total_data_gb,\n",
        "  year,\n",
        "  month\n",
        "FROM\n",
        "  telecom.gold.vw_usage_analysis\n",
        "ORDER BY\n",
        "  year,\n",
        "  month"
      ]
    },
    {
      "name": "revenue_analysis",
      "displayName": "Revenue Analysis",
      "queryLines": [
        "SELECT\n",
        "  year_month,\n",
        "  net_billed_amount,\n",
        "  year,\n",
        "  month,\n",
        "  paid_bills,\n",
        "  unpaid_bills,\n",
        "  overdue_bills\n",
        "FROM\n",
        "  telecom.gold.vw_revenue_analysis\n",
        "ORDER BY\n",
        "  year,\n",
        "  month"
      ]
    },
    {
      "name": "complaint_analysis",
      "displayName": "Complaint Analysis",
      "queryLines": [
        "SELECT\n",
        "  category_name,\n",
        "  total_complaints,\n",
        "  open_complaints,\n",
        "  in_progress_complaints,\n",
        "  resolved_complaints,\n",
        "  avg_resolution_days\n",
        "FROM\n",
        "  telecom.gold.vw_complaint_analysis\n",
        "ORDER BY\n",
        "  total_complaints DESC"
      ]
    },
    {
      "name": "churn_risk",
      "displayName": "Churn Risk Distribution",
      "queryLines": [
        "SELECT\n",
        "  churn_risk_level,\n",
        "  COUNT(*) AS customer_count,\n",
        "  ROUND(SUM(outstanding_amount), 2) AS outstanding_amount\n",
        "FROM\n",
        "  telecom.gold.customer_360\n",
        "GROUP BY\n",
        "  churn_risk_level\n",
        "ORDER BY\n",
        "  CASE churn_risk_level\n",
        "    WHEN 'HIGH' THEN 1\n",
        "    WHEN 'MEDIUM' THEN 2\n",
        "    WHEN 'LOW' THEN 3\n",
        "  END"
      ]
    },
    {
      "name": "resolution_status_series",
      "displayName": "Resolution Status by Category",
      "queryLines": [
        "SELECT\n",
        "  category_name,\n",
        "  'Open' as status_type,\n",
        "  open_complaints as count\n",
        "FROM\n",
        "  telecom.gold.vw_complaint_analysis\n",
        "UNION ALL\n",
        "SELECT\n",
        "  category_name,\n",
        "  'In Progress' as status_type,\n",
        "  in_progress_complaints as count\n",
        "FROM\n",
        "  telecom.gold.vw_complaint_analysis\n",
        "UNION ALL\n",
        "SELECT\n",
        "  category_name,\n",
        "  'Resolved' as status_type,\n",
        "  resolved_complaints as count\n",
        "FROM\n",
        "  telecom.gold.vw_complaint_analysis\n",
        "ORDER BY\n",
        "  category_name,\n",
        "  CASE status_type\n",
        "    WHEN 'Open' THEN 1\n",
        "    WHEN 'In Progress' THEN 2\n",
        "    ELSE 3\n",
        "  END"
      ]
    },
    {
      "name": "billing_status_series",
      "displayName": "Billing Status by Month",
      "queryLines": [
        "SELECT\n",
        "  year_month,\n",
        "  'Paid' as status_type,\n",
        "  paid_bills as count\n",
        "FROM\n",
        "  telecom.gold.vw_revenue_analysis\n",
        "UNION ALL\n",
        "SELECT\n",
        "  year_month,\n",
        "  'Unpaid' as status_type,\n",
        "  unpaid_bills as count\n",
        "FROM\n",
        "  telecom.gold.vw_revenue_analysis\n",
        "UNION ALL\n",
        "SELECT\n",
        "  year_month,\n",
        "  'Overdue' as status_type,\n",
        "  overdue_bills as count\n",
        "FROM\n",
        "  telecom.gold.vw_revenue_analysis\n",
        "ORDER BY\n",
        "  year_month,\n",
        "  CASE status_type\n",
        "    WHEN 'Paid' THEN 1\n",
        "    WHEN 'Unpaid' THEN 2\n",
        "    ELSE 3\n",
        "  END"
      ]
    }
  ],
